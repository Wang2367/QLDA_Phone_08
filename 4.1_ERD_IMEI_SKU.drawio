        <mxCell id="note2" value="Sổ tồn giữ loại và ID dòng chứng từ. Một dòng có thể sinh nhiều biến động (leg)." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#18283A;fontFamily=Segoe UI;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
