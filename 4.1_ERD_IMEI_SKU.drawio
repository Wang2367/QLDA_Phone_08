        <mxCell id="note3" value="request_keys chống ghi lặp; audit_events truy vết phê duyệt, đổi trạng thái IMEI, điều chỉnh tồn và bảo hành." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#18283A;fontFamily=Segoe UI;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
